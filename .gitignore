        best_intervals = offsetrange[min_SER_indices]
        print(f"For M = {M}, beta = {beta}, EbN0dB = 15:")
        print(f"Possible time intervals for sampling received signal: 
        print(f"SER values for each time interval: {ser}")
        print(f"The best time intervals for sampling the received signal are:
    plt.show()
M=[2,4]
for i in M:
    eyeplot(i)
