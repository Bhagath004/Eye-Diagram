import numpy as np
import matplotlib.pyplot as plt
def generate_MPAM_signal(M,N):
    levels=np.arange(-(M-1),M,2) #Generate the amplitude levels
    d=np.random.choice(levels,size=N) #Generate the signal
    return d,levels
def upsample_signal(d,L,N): #Upsample the signal
    v=np.zeros(N*L)
    v[::L]=d
    return v
def generate_srrc(beta,Ts,Nsym,L,t): #Generate the square root raised cosine pulse
    p=np.zeros_like(t)
    for i in range(len(t)):
        if t[i]==0:
           p[i]=(1/Ts)*(1+beta*((4/np.pi)-1))
        elif abs(t[i])==Ts/(4*beta):
           p[i]=(beta/(Ts*np.sqrt(2)))*(((1+2/np.pi)*np.sin(np.pi/(4
        else:
           p[i]=(1/Ts)*((np.sin(np.pi*t[i]/Ts*(1-beta)))+(4*beta*t[i
    # Normalize the pulse shape energy to unity
    k=np.sqrt(np.sum(p**2)) #rms value
    p=p/k #normalisation
    return p
def awgn(s,M,L):
    sp=L*np.sum(np.abs(s)**2)/len(s) #signal power
    snr=10*np.log10(np.log2(M))+15 #SNR per symbol
    npsd=sp/(2*10**(snr/10)) #noise power spectral density
    n=np.random.normal(0,np.sqrt(npsd),len(s))
    return n
def matched_filter(p,offsetrange,symbols,M,Nsym,L,v,d):
    D=int(Nsym*L/2)
    s=np.convolve(v,p) # Convolve the upsampled input stream 'v' with the shaping pulse 'p
    ser=[]
    for i in offsetrange:
        r=v+awgn(v,M,L)
        h=p[::-1]
        s_hat=np.convolve(r,h)
        v_hat=s_hat[2*D+i:len(s_hat)-2*D+i:L]
        dist=np.abs(v_hat.reshape(-1,1)-symbols.reshape(1,-1))
        temp=np.argmin(dist,axis=1)
        d_hat = symbols[temp]
        ser.append(np.sum(d!=d_hat)/len(d))
    return s,s_hat,ser
def transmission_filter(p,v):
    s=np.convolve(v,p) # Convolve the upsampled input stream 'v' with the shaping pulse 'p
    return s
def plotEyeDiagram(beta,s, L, offset,t,x):
    traces = np.reshape(s[offset:t*L- offset],(-1,L)).transpose()
    plt.plot(traces)
    plt.xlabel('Time [samples]')
    plt.ylabel('Amplitude')
    plt.title(f'Eye Diagram {x} for M={i}, Î²={beta}, EbN0dB= 15dB')
def receive_srrc(beta,Ts,Nsym,L,t): 
    p=np.zeros_like(t)
    for i in range(len(t)):
        if t[i]==0:
           p[i]=(1/Ts)*(1+beta*((4/np.pi)-1))
        elif abs(t[i])==Ts/(4*beta):
           p[i]=(beta/(Ts*np.sqrt(2)))*(((1+2/np.pi)*np.sin(np.pi/(4
        else:
           p[i]=(1/Ts)*((np.sin(np.pi*t[i]/Ts*(1-beta)))+(4*beta*t[i])
    k=np.sqrt(np.sum(p**2)) 
    p=p/k 
    return p
def eyeplot(M):
    N=10**5
    d,symbols=generate_MPAM_signal(M, N)
    L=8
    v=upsample_signal(d, L,N)
    beta_values=[0.3,0.5,0.8]
    Ts=1
    Nsym=8
    t=np.linspace(-Nsym/2,Nsym/2,Nsym*L+1) 
    num2=0
    for beta in beta_values:
        num2+=1
        p=generate_srrc(beta,Ts,Nsym,L,t)
        q=receive_srrc(beta,Ts,Nsym,L,t)
        offsetrange=np.arange(-4,5)
        z=transmission_filter(p,v)
        s,s_hat,ser=matched_filter(q,offsetrange,symbols,i, Nsym, L,z
        if beta==0.3:
           print(ser)
        plt.subplot(3,3,num2)
        plotEyeDiagram(beta,s_hat, 2*L, offset=int(Nsym*(L)), t=100,x
        plt.tight_layout()
        plt.subplot(3,3,(num2+3))
        plotEyeDiagram(beta,s, 2*L, offset=int(Nsym*(L)),t=100,x='without noise'
        plt.tight_layout()
        plt.subplot(3,3,(num2+6))
        plt.plot(offsetrange,ser, 'bo-', linewidth=2, markersize=8)
        plt.grid(True)
        plt.title(f'SER vs offset for M={i}, Î²={beta}, EbN0dB=15dB')
        plt.xlabel("offset(in dB)")
        plt.ylabel('Symbol Error Rate')
